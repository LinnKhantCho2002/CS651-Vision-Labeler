# Documentation only. The app reads process environment; this file is not auto-loaded.
PORT=8080
# Local ADC: gcloud auth application-default login
# Set quota project: gcloud auth application-default set-quota-project YOUR_PROJECT_ID
# App Engine uses its attached runtime service account automatically.
DEMO_MODE=false
MAX_REQUESTS_PER_WINDOW=20
RATE_WINDOW_MS=600000
MAX_CONCURRENT_ANALYSES=1
